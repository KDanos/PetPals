<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign-in</title>
    <link rel="stylesheet" href="/stylesheets/forms.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
</head>
<%- include ('../partials/_navbar_KD.ejs') %>

    <body>
        <div class="form-container-center"></div>
        <form action="/auth/sign-in" method="POST">
            <label for="username">Username:</label>
            <input type="text" id="username" name="username" placeholder="e.g. ILikePuppies" required>
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required>
            <button class ="profile-button" type="submit" id="sign-in-button">Sign-in</button>
            <p class="auth-error"> <%- (message) %> </p>
        </form>
        </div>
    </body>

</html>