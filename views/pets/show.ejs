<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=, initial-scale=1.0">
    <title>
        <%= pet.name %>
    </title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

</head>

<body>
    <%- include ('../partials/_navbar_KD.ejs') %>
        <div class="profile-container">
            <h1>
                <%= pet.name %> welcomes you!
            </h1>
            <p class="auth-error">
                <%- (message) %>
            </p>
            <div class="profile-content">
                <div class="profile-item">
                    <div class="profile-card">
                        <div class="profile-icon">👤</div>

                        <div class="profile-info">
                            <span class="profile-label">Name: </span>
                            <span class="profile-value">
                                <%= pet.name %>
                            </span>
                        </div>

                        <div class="profile-info">
                            <span class="profile-label">Animal: </span>
                            <span class="profile-value">
                                <%= pet.animal %>
                            </span>
                        </div>

                        <div class="profile-info">
                            <span class="profile-label">Owner: </span>
                            <span class="profile-value">
                                <%= pet.owner.username %>
                            </span>
                        </div>

                        <% if(user && pet.owner._id == user._id) { %>
                             <a class="profile-button" href='/pets/<%=pet._id%>/edit'>Edit Information</a>
                            <%} %>
                               
                    </div>
                    <!-- **********************new card************************************** -->
                    <div class="profile-card">
                        <div class="profile-icon">🐾</div>
                        <div class="profile-info">
                            <% if (!pet.minder || pet.minder.length===0){ %>
                                <p> you have not carers to call upon </p>
                                <% } else { %>
                                    <p> here are you pets</p>
                                    <ul>
                                        <% pet.minders.forEach((person)=>{ %>
                                            <li>
                                                <a href="/pets/<%=person._id%>">
                                                    <%= person.username %>
                                                </a>
                                            </li>
                                            <% }) %>
                                                <%} %>
                                    </ul>
                        </div>
                        <% if(user && pet.owner._id == user._id) { %>
                        <a class="profile-button" href='/users/<%=user._id%>/pets'>View/Edit Carers</a>
                        <% } %>
                    </div>
                    <!-- **********************new card************************************** -->


                </div>
            </div>
</body>

</html>