<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=, initial-scale=1.0">
    <title>
        <%= user.username %>-My Services>
    </title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
    <link rel="stylesheet" href="/stylesheets/services.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>

<body>
    <%- include ('../partials/_navbar_KD.ejs') %>

        <div class="welcome-section">
            <% if (user.services.length===0){ %>
                <h1>You are not offering any services yet <%= user.username %>
                </h1>
                <p class="subtitle">Lets see how you can help your fellow pet lovers!</p>
                <% } else { %>
                    <h1>Here are your pets <%= user.username %>
                    </h1>
                    <p class="subtitle">Your beloved companions</p>
                    <% } %>
        </div>

        <div class="profile-container">

            <div class="add-service-section">
                <a class="profile-button" href='/services/new'> Offer a new service</a>
            </div>


            <div class="row">
                <% user.pets.forEach((animal)=>{ %>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="profile-card">
                            <a href="/pets/<%= animal._id %>" class="profile-card-link">
                                <div class="profile-icon-large">
                                    <% if (animal.animal==='Dog' ) { %>
                                        🐕
                                        <% } else if (animal.animal==='Cat' ) { %>
                                            🐈
                                            <% } else if (animal.animal==='Bird' ) { %>
                                                🐦
                                                <% } else if (animal.animal==='Fish' ) { %>
                                                    🐠
                                                    <% } else if (animal.animal==='Rabbit' ) { %>
                                                        🐰
                                                        <% } else if (animal.animal==='Duck' ) { %>
                                                            🦆
                                                            <% } else { %>
                                                                🐾
                                                                <% } %>
                                </div>
                                <h3>
                                    <%= animal.name %>
                                </h3>
                                <div class="profile-value">
                                    <%= animal.animal %>
                                </div>
                                <div class="profile-badges">
                                    <span class="badge-custom">🐾 Pet</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
</body>

</html>