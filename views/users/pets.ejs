<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=, initial-scale=1.0">
    <title>
        <%= user.username %>
    </title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

</head>

<body>
    <%- include ('../partials/_navbar_KD.ejs') %>
        <div class="profile-container">
           
                <% if (user.pets.length===0){ %>
                    
                    <span>   <h1>You dont have any pets with us yet <%= user.username %></h1></span>

                        <% } else { %>
                            <span>  <h1>Here are your pets <%= user.username %></h1></span>
                            <% } %>
                            <span>  <a class="profile-button" href='/pets/new'>Add a new pet</a></span>
                    
                    <div class="profile-content">
                        <% user.pets.forEach((animal)=>{ %>
                            <div class="profile-card">
                                <div class="profile-icon">👤</div>

                                <div class="profile-info">
                                    <span class="profile-label">Username: </span>
                                    <span class="profile-value">
                                        <%= user.username %>
                                    </span>
                                </div>

                                <div class="profile-info">
                                    <span class="profile-label">Email: </span>
                                    <span class="profile-value">
                                        <%= user.email %>
                                    </span>
                                </div>
                                <a class="profile-button" href='/users/<%=user._id%>/edit'>Edit Profile</a>
                            </div>
                            <% }) %>)
                    </div>


        </div>
</body>

</html>