<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetPals-Carers</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/carers.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

</head>


    <body>
        <%- include ('../partials/_navbar_KD.ejs') %>
        <div class="welcome-section">
            <h1>Meet Our Pet Carers</h1>
            <p class="subtitle">Everyone to take care of your family</p>
            <p class="description">A few words about our trusted pet carers - why you should trust them with your 4
                legged or winged friend</p>
        </div>

        <div class="carers-container">
            <div class="row">
                <% carers.forEach(person=>{ %>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="carer-container">
                            <a href="/users/<%= person._id %>" class="carer-card-link">
                                <div class="carer-icon-large">🐾</div>
                                <h3>
                                    <%= person.username %>
                                </h3>
                                <div class="carer-email">
                                    <%= person.email %>
                                </div>

                                    <div class="carer-badges">
                                        <span class="badge-custom badge-verified">✓ Pet Carer</span>
                                        <% if (person.pets && person.pets.length> 0) { %>
                                            
                                            <span class="badge-custom">
                                                <%= person.pets.length %>
                                                    <%= person.pets.length===1 ? 'Pet' : 'Pets' %>
                                            </span>
                                            <% } %>
                                    </div>
                            </a>
                        </div>
                    </div>

                    <% }) %>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    </body>

</html>