<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome</title>
    <link rel="stylesheet" href="../stylesheets/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>

<body>
    <%- include('./partials/_navbar.ejs') %>
        <h1>Welcome to PetPals
            <% if (user) {%>
                <%= user.username %>
                    <% } %>
        </h1>
        <div>
            <p>Where we bring pets, owners and minders together</p>
            <p>Showcase your fairy, scaly or winged family memebers</p>
            <p>Let fellow animal lovers know you are availbale to take care of their loved ones when its time or need to be away</p>
            
        </div>
        <div class="row custom-masonry-container">
            <% photosArray.forEach((imgName)=>{ %>
                <div class="col-lg-3 col-md-6 mb-3" style="break-inside: avoid;">
                    <div class="image-wrapper">
                        <img src="/images/Landing Page Images/<%= imgName %>"
                            alt="<%= imgName.replace(/\.(jpe?g)$/i, '').replace(/_/g, ' ') %>" loading="lazy"
                            class="img-fluid">
                    </div>
                </div>
                <% }) %>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

</html>
</body>

</html>